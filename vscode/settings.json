{
  // ---- theme & type ----
  "workbench.colorTheme": "Rosé Pine Moon",
  "workbench.iconTheme": "material-icon-theme",
  "material-icon-theme.hidesExplorerArrows": false,
  "editor.fontFamily": "'JetBrainsMono NFM', 'JetBrainsMono Nerd Font Mono', Menlo, monospace",
  "editor.fontSize": 14,
  "editor.lineHeight": 1.9,
  "editor.fontLigatures": false,
  "editor.fontVariations": false,
  "window.zoomLevel": 1,
  "workbench.settings.applyToAllProfiles": ["editor.fontFamily"],

  // ---- seamless sidebar ----
  "workbench.colorCustomizations": {
    "sideBar.border": "#232136",
    "sideBarSectionHeader.background": "#232136",
    "sideBarSectionHeader.border": "#232136",
    "editorGroup.border": "#232136",
    "titleBar.activeBackground": "#232136",
    "titleBar.inactiveBackground": "#232136",
    "statusBar.background": "#232136",
    "statusBar.border": "#232136",
    "statusBar.noFolderBackground": "#232136",
    "statusBar.debuggingBackground": "#232136",
    "list.activeSelectionBackground": "#2a283e",
    "list.inactiveSelectionBackground": "#2a283e",
    "list.focusBackground": "#2a283e",
    "list.hoverBackground": "#2a283e",
    "scrollbarSlider.background": "#00000000",
    "scrollbarSlider.hoverBackground": "#00000000",
    "scrollbarSlider.activeBackground": "#00000000",
    "scrollbar.shadow": "#00000000",
    "editorOverviewRuler.border": "#00000000",
    "editorOverviewRuler.background": "#00000000"
  },

  // ---- strip the chrome ----
  "workbench.activityBar.location": "hidden",
  "workbench.sideBar.location": "left",
  "workbench.statusBar.visible": true,
  "workbench.editor.showTabs": "none",
  "workbench.layoutControl.enabled": false,
  "window.commandCenter": false,
  "chat.commandCenter.enabled": false,
  "window.customTitleBarVisibility": "never",
  "timeline.excludeSources": ["timeline.localHistory", "git-history"],
  "workbench.startupEditor": "none",
  "workbench.tips.enabled": false,
  "workbench.editor.empty.hint": "hidden",
  "workbench.tree.renderIndentGuides": "always",
  "workbench.editor.editorActionsLocation": "hidden",
  "breadcrumbs.enabled": false,

  "editor.minimap.enabled": false,
  "editor.scrollbar.vertical": "hidden",
  "editor.scrollbar.horizontal": "hidden",
  "editor.overviewRulerBorder": false,
  "editor.scrollbar.verticalScrollbarSize": 0,
  "editor.scrollbar.horizontalScrollbarSize": 0,
  "editor.scrollbar.scrollByPage": false,
  "editor.hideCursorInOverviewRuler": true,
  "editor.showFoldingControls": "never",
  "editor.stickyScroll.enabled": false,
  "editor.renderWhitespace": "none",
  "editor.lightbulb.enabled": "off",

  // ---- no animations ----
  "workbench.reduceMotion": "on",
  "editor.smoothScrolling": false,
  "editor.cursorSmoothCaretAnimation": "off",
  "workbench.list.smoothScrolling": false,
  "terminal.integrated.smoothScrolling": false,

  // ---- editing feel ----
  "editor.lineNumbers": "relative",
  "editor.padding.top": 0,
  "editor.cursorSurroundingLines": 8,
  "editor.cursorSurroundingLinesStyle": "all",
  "editor.cursorBlinking": "solid",
  "editor.renderLineHighlight": "all",
  "editor.hover.enabled": "on",
  "editor.matchBrackets": "always",
  "editor.guides.bracketPairs": false,
  "editor.guides.indentation": false,
  "editor.scrollBeyondLastLine": true,

  // ---- zen ----
  "zenMode.centerLayout": false,
  "zenMode.fullScreen": false,
  "zenMode.hideLineNumbers": false,
  "zenMode.showTabs": "none",
  "zenMode.silentNotifications": true,
  "workbench.editor.centeredLayoutAutoResize": false,

  "window.titleBarStyle": "native",
  "custom-ui-style.electron": {
    "titleBarStyle": "hiddenInset"
  },
  "custom-ui-style.font.monospace": "JetBrainsMono NFM",
  "custom-ui-style.stylesheet": {
    // no animations anywhere
    "*, *::before, *::after": "transition: none !important; animation: none !important",
    // status bar: only the neovim item (mode, messages, errors)
    ".statusbar-item:not([id^='asvetliakov.vscode-neovim'])": "display: none !important",
    // sidebar: no "Explorer ···" header, no border
    ".sidebar .title": "display: none !important",
    ".sidebar": "border: none !important",
    // taller explorer rows
    ".explorer-folders-view .monaco-list-row": "height: 30px !important; line-height: 30px !important",
    // strip remaining chrome
    ".title-actions": "display: none !important",
    ".panel .composite.title": "visibility: hidden !important",
    ".monaco-editor .scroll-decoration": "display: none !important",
    ".monaco-scrollable-element > .shadow.top": "display: none !important",
    ".editor-widget.find-widget, .quick-input-widget": "box-shadow: none !important",
    ".monaco-workbench .monaco-list:not(.element-focused):focus:before": "outline: none !important",
    ".monaco-split-view2 > .monaco-scrollable-element > .split-view-container": "background: #232136 !important"
  },

  // ---- explorer ----
  "files.simpleDialog.enable": true,
  "explorer.compactFolders": false,
  "explorer.confirmDragAndDrop": false,
  "explorer.confirmDelete": false,

  // ---- terminal ----
  "terminal.integrated.fontFamily": "'JetBrainsMono NFM', 'JetBrainsMono Nerd Font Mono', Menlo, monospace",
  "terminal.integrated.fontSize": 13,
  "terminal.integrated.lineHeight": 1.4,
  "terminal.integrated.tabs.enabled": false,

  // ---- fzf-picker ----
  "fzf-picker.general.terminalLocation": "panel",
  "fzf-picker.general.batTheme": "base16",
  "fzf-picker.findFiles.previewWindowConfig": "right:50%:border-left",
  "fzf-picker.findWithinFiles.previewWindowConfig": "right:50%:border-left:+{2}+3/3:~3",

  // ---- neovim ----
  "vscode-neovim.neovimExecutablePaths.darwin": "/opt/homebrew/bin/nvim",
  "extensions.experimental.affinity": {
    "asvetliakov.vscode-neovim": 1
  },

  // ---- your existing prefs ----
  "files.autoSave": "afterDelay",
  "files.insertFinalNewline": true,
  "git.autofetch": true,
  "git.blame.statusBarItem.enabled": false,
  "git.blame.editorDecoration.enabled": false,
  "git.decorations.enabled": true,
  "scm.diffDecorations": "all",
  "git.confirmSync": false,
  "editor.inlineSuggest.enabled": false,
  "editor.inlineSuggest.edits.experimental.enabled": false,
  "editor.inlineSuggest.edits.experimental.onlyShowWhenCloseToCursor": false,
  "extensions.ignoreRecommendations": true,
  "cmake.options.statusBarVisibility": "visible",
  "liveServer.settings.donotShowInfoMsg": true,
  "liveServer.settings.donotVerifyTags": true,
  "postman.mcp.notifications.postmanMCP": false,
  "chat.instructionsFilesLocations": {
    ".github/instructions": true,
    ".claude/rules": true,
    "~/.copilot/instructions": true,
    "~/.claude/rules": true,
    "/var/folders/vj/w7lwjy1114n44xsrjnb_m6z40000gn/T/postman-collections-post-response.instructions.md": true,
    "/var/folders/vj/w7lwjy1114n44xsrjnb_m6z40000gn/T/postman-collections-pre-request.instructions.md": true,
    "/var/folders/vj/w7lwjy1114n44xsrjnb_m6z40000gn/T/postman-folder-post-response.instructions.md": true,
    "/var/folders/vj/w7lwjy1114n44xsrjnb_m6z40000gn/T/postman-folder-pre-request.instructions.md": true,
    "/var/folders/vj/w7lwjy1114n44xsrjnb_m6z40000gn/T/postman-http-request-post-response.instructions.md": true,
    "/var/folders/vj/w7lwjy1114n44xsrjnb_m6z40000gn/T/postman-http-request-pre-request.instructions.md": true
  }
}
